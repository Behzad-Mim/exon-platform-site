{
  "name": "moonplatform-site",
  "private": true,
  "description": "moonplatform.app — Moon Platform's site. The pages are in public/; src/ is bundled into public/assets/.",
  "scripts": {
    "build": "esbuild src/main.js src/page.js --bundle --minify --format=esm --target=es2020 --outdir=public/assets --entry-names=[name] --legal-comments=linked",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  }
}
